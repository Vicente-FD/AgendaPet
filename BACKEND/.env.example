# ─── Servidor ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Orígenes permitidos para CORS (coma-separados). En dev, la app Flutter web.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Base de datos (PostgreSQL) ──────────────────────────────────────────────
# Coincide con docker-compose.yml.
DATABASE_URL=postgresql://agendapet:agendapet@localhost:5432/agendapet?schema=public

# Conexión directa para migraciones (misma cadena en modo sesión).
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Almacenamiento de fotos (Supabase Storage) ─────────────────────────────
# Crea un bucket público llamado "pets" en el panel de Supabase.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=pets

# ─── JWT (tokens propios de la API) ─────────────────────────────────────────
# Genera secretos con: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Google Sign-In (verificación del ID token) ─────────────────────────────
# Client IDs de OAuth (Android, iOS, Web). Coma-separados; se aceptan todos.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

# ─── Sign in with Apple (verificación del identity token) ────────────────────
# Tu App ID (bundle id) y, si usas Services ID para web, agrégalo también.
APPLE_CLIENT_IDS=cl.agendapet.app

# ─── Compras in-app ─────────────────────────────────────────────────────────
# Solo para pruebas locales: acepta comprobantes SIN verificar la firma.
# Jamás en producción: cualquiera podría activarse el plan PRO gratis.
ALLOW_UNVERIFIED_IAP=false

# ─── IAP: Apple App Store Server API ────────────────────────────────────────
# Necesario para validar compras y verificar App Store Server Notifications v2.
APPLE_IAP_ENABLED=false
APPLE_BUNDLE_ID=cl.agendapet.app
APPLE_ISSUER_ID=00000000-0000-0000-0000-000000000000
APPLE_KEY_ID=ABCDE12345
# Ruta al .p8 de la API In-App Purchase (App Store Connect > Users and Access > Keys).
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey_ABCDE12345.p8
# Carpeta con los certificados raíz de Apple (descárgalos de apple.com/certificateauthority).
APPLE_ROOT_CERTS_DIR=./secrets/apple-root-certs
# App Apple ID (número) de tu app en App Store Connect.
APPLE_APP_APPLE_ID=0000000000
# sandbox | production
APPLE_ENVIRONMENT=sandbox

# ─── IAP: Google Play Developer API ─────────────────────────────────────────
# Service account con acceso a la app en Play Console para validar compras.
GOOGLE_PLAY_ENABLED=false
GOOGLE_PLAY_PACKAGE_NAME=cl.agendapet.app
# Ruta al JSON del service account.
GOOGLE_SERVICE_ACCOUNT_PATH=./secrets/play-service-account.json
# Token compartido para autenticar el push de RTDN (Pub/Sub) si lo configuras.
GOOGLE_RTDN_VERIFICATION_TOKEN=change-me-rtdn-token
